# =====================================================================
# GTshop · Variables de entorno
# Copia este archivo a `.env.local` y rellena tus claves reales.
# NO subas `.env.local` al repositorio.
# =====================================================================

# ---- Supabase ----
# Panel de Supabase -> Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://tu-proyecto.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=tu-anon-key
# Service role key (SECRETA, solo servidor). NUNCA la expongas en el cliente.
SUPABASE_SERVICE_ROLE_KEY=tu-service-role-key

# ---- Stripe ----
# Panel de Stripe -> Developers -> API keys (usa las de modo TEST para desarrollo)
STRIPE_SECRET_KEY=sk_test_xxx
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_xxx
# Secreto del webhook. En local lo da `stripe listen` (whsec_...).
# En producción, el que genera el endpoint en el panel de Stripe.
STRIPE_WEBHOOK_SECRET=whsec_xxx

# ---- App ----
# URL pública del sitio (para las redirecciones de Stripe Checkout).
NEXT_PUBLIC_SITE_URL=http://localhost:3000
